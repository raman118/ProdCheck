# Local development works without any environment variables.

# Optional: improves GitHub API rate limits.
GITHUB_TOKEN=

# Production only: PostgreSQL/Supabase connection URL. Local development defaults to SQLite.
DATABASE_URL=

# Optional: stable HMAC key for IP-based scan rate-limit fingerprints.
RATE_LIMIT_SECRET=

# Optional LLM explanations are off unless explicitly enabled and a provider key is configured.
PRODCHECK_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
